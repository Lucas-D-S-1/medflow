# Copie para .env e preencha somente na sua maquina.
# O .env e o diretorio wallets/ sao ignorados pelo Git.

# Usuario de aplicacao. O ADMIN e usado apenas no setup inicial
# (01_criar_usuario_medflow.sql) e nao entra aqui.
ORACLE_USER=MEDFLOW
ORACLE_PASSWORD=

# Alias do tnsnames.ora do wallet. O workload Lakehouse expoe
# medflow_tpurgent, medflow_tp, medflow_high, medflow_medium e medflow_low.
# Confirme o valor real no tnsnames.ora antes de usar.
ORACLE_DSN=medflow_low

# Opcional: alias usado apenas por carregar_gold.py. O _medium roda consultas
# em paralelo e serve melhor a carga em lote. Se ficar vazio, usa ORACLE_DSN.
ORACLE_DSN_CARGA=medflow_medium

ORACLE_WALLET_DIR=./wallets/MEDFLOW
ORACLE_WALLET_PASSWORD=

# Raiz REST do esquema, sem o caminho do modulo. Nao e credencial: e a mesma
# URL que o site publicado expoe ao navegador. Fica fora do Git so para o
# repositorio nao ficar preso a uma instancia. Formato:
# https://<host>.adb.<regiao>.oraclecloudapps.com/ords/medflow
ORDS_BASE_URL=

# Modulo ORDS que as ferramentas consultam. `api/dev/v1` e o de trabalho, com
# CORS liberado para localhost; `api/v1` e o publico, que serve o site. A
# reconciliacao, o teste de contrato e o gerador de snapshots leem daqui.
ORDS_API_PATH=api/dev/v1
